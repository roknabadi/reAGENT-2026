# Copy to .env and add your own credential.
# Never commit .env.

# Gates every model call (src/reagent_workflow/agent.py). Without it, the UI
# degrades to token-match context resolution and proposes no library.
ANTHROPIC_API_KEY=

# Optional: publish BenchFlow comparison traces to a private HF dataset.
HF_TOKEN=
BENCHFLOW_HF_REPO=
